import {
  "cross_framework/md_editor_moui/app",
  "examples/markdown_editor" @md_editor,
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/render",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui/services",
  "wzzc-dev/moui/backend",
  "wzzc-dev/moui/backend/common/lifecycle" @window_lifecycle,
  "wzzc-dev/moui/backend/macos" @macos_backend,
  "wzzc-dev/moui_richtext" @richtext,
  "wzzc-dev/moui_skia",
  "wzzc-dev/moui_skia/native" @skia_native,
  "wzzc-dev/moui_skia_renderer" @skia_renderer,
  "wzzc-dev/moui_wgpu_renderer" @render_wgpu,
  "wzzc-dev/moui_wgpu_renderer/coretext" @wgpu_coretext,
  "wzzc-dev/moui_wgpu_renderer/cosmic_text" @wgpu_cosmic,
  "Milky2018/wgpu_mbt" @wgpu,
  "Milky2018/wgpu_mbt/c" @wgpu_c,
  "wzzc-dev/moui/text",
  "moonbitlang/x/fs",
  "moonbitlang/core/env",
  "moonbitlang/async",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "native-stub": [ "benchmark_clock.c", "benchmark_metal_layer.c" ],
)
