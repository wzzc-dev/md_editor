import {
  "cross_framework/md_editor_moui/app",
  "wzzc-dev/moui/core",
  "wzzc-dev/moui/runtime",
  "wzzc-dev/moui_richtext" @richtext,
  "wzzc-dev/moui_skia_renderer" @skia_renderer,
  "wzzc-dev/moui_wgpu_renderer" @render_wgpu,
  "wzzc-dev/moui_wgpu_renderer/directwrite" @wgpu_directwrite,
  "wzzc-dev/moui_wgpu_renderer/cosmic_text" @wgpu_cosmic,
  "Milky2018/wgpu_mbt" @wgpu,
  "Milky2018/wgpu_mbt/c" @wgpu_c,
  "wzzc-dev/moui/text",
  "moonbitlang/x/fs",
  "moonbitlang/core/env",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "native-stub": [
    "benchmark_clock.c",
    "benchmark_surface.c",
  ],
  link: { "native": { "cc-link-flags": "d3d12.lib dxgi.lib" } },
)
